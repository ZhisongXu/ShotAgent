{
  "schema": "reference-video-grade-manifest/v2",
  "dataset": "NLUT official video examples x VideoColorGrading official reference videos",
  "protocol": {
    "task": "reference-video controlled photorealistic color grading without ground truth",
    "pairing": "nine independent NLUT target sequences with a balanced rotation over three VideoColorGrading references",
    "aggregation": "compute every metric per sequence, then macro-average sequences with sample standard deviation and 95% normal interval",
    "baseline_reference_adapter": "use the temporal middle reference frame for methods whose published interface accepts one style image",
    "shotagent_reference_adapter": "use an ordered reference-video storyboard and full-video measured style profile",
    "frame_policy": "first 96 target frames at native cadence, resized only when the long side exceeds 512 pixels",
    "ranking": "per-metric average rank across sequences; no composite score"
  },
  "sources": {
    "targets": "https://github.com/semchan/NLUT",
    "references": "https://github.com/seunghyuns98/VideoColorGrading/tree/main/examples"
  },
