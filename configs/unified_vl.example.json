{
  "backend": {
    "type": "unified_vl_video",
    "grade_schema": "pool-graph/v2",
    "provider": "openai_responses",
    "base_url": "https://api.openai.com/v1",
    "model": "gpt-5.6-sol",
    "api_key_env": "OPENAI_API_KEY",
    "timeout_seconds": 180,
    "max_retries": 8,
    "retry_base_seconds": 2.0,
    "retry_max_seconds": 60.0,
    "json_mode": true,
    "reasoning_effort": "high",
    "image_detail": "high",
    "max_output_tokens": 8192,
    "max_image_side": 1280,

    "operations": {
      "primary": true,
      "white_balance": true,
      "global_color": true,
      "hsl8": true,
      "color_wheels": true,
      "curves": true,
      "texture": true,
      "optical_effects": true,
      "denoise": true
    },

    "lut_catalog": {},

    "operation_policy": {
      "maximum_operations_per_shot": 9,
      "maximum_additional_fidelity_l1": 0.12,
      "maximum_added_clipping": 0.03,
      "minimum_review_score": 0.6,
      "maximum_planning_attempts": 2,
      "strict": false
    },

    "storyboard": {
      "allow_fallback": false,
      "long_video": {
        "overview_frames": 24,
        "window_seconds": 20.0,
        "overlap_seconds": 4.0,
        "max_window_images": 28,
        "technical_candidate_threshold": 0.14,
        "hard_cut_threshold": 0.42,
        "boundary_context_frames": 3,
        "boundary_batch_size": 4,
        "boundary_merge_tolerance_seconds": 0.2,
        "boundary_accept_confidence": 0.55,
        "anchor_candidates_per_shot": 10,
        "anchor_shots_per_call": 3,
        "max_anchor_images_per_call": 30,
        "hero_max_images_per_call": 32,
        "hero_nominees_per_batch": 3,
        "hero_candidate_count": 5,
        "minimum_shot_seconds": 0.4
      }
    },

    "editor": {
      "stages": ["technical", "look", "selective_color", "texture", "optical"],
      "candidate_count": 16,
      "seed": 7,
      "transactional": true
    },

    "review": {
      "enabled": true,
      "strict": true,
      "focus": "instruction adherence, preservation, professional color, and cross-frame coherence",
      "metric_weight": 0.55,
      "visual_weight": 0.45,
      "acceptance_score": 0.6
    },

    "safety": {
      "maximum_fidelity_l1": 0.42,
      "maximum_clipping": 0.2,
      "maximum_temporal_error": 0.1,
      "maximum_parameter_jerk": 0.2,
      "maximum_anchor_error": 0.12,
      "rollback_on_failure": true
    },

    "search": {
      "maximum_evaluations": 12,
      "maximum_hero_attempts": 3,
      "exploration_constant": 1.41421356237,
      "rejection_penalty": 0.25,
      "seed": 7
    }
  }
}
